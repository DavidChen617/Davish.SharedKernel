<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  </PropertyGroup>
  
  <PropertyGroup>
    <PackageId>Davish.$(MSBuildProjectName)</PackageId>
    <Authors>David Chen</Authors>
    <Copyright>Copyright (c) 2026 David Chen</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <PackageProjectUrl>https://github.com/DavidChen617/Davish.SharedKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DavidChen617/Davish.SharedKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>DDD-SharedKernel;</PackageTags>
    <RootNamespace>Davish.SharedKernel</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Davish.Sendr.Notification.Abstractions" Version="2.0.0" />
  </ItemGroup>

</Project>
